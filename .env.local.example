# URL pública de la aplicación local.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase local: ejecutar `npm run supabase:status` y copiar sus valores.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55421
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Correo: proveedor intercambiable. Local usa Nodemailer hacia Mailpit.
EMAIL_SENDING_PROVIDER=nodemailer
EMAIL_FROM="Entradas <no-reply@illapasystems.com>"
EMAIL_REPLY_TO=
SMTP_HOST=127.0.0.1
SMTP_PORT=55425
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
CRON_SECRET=

# Guardia: definir valores seguros, nunca versionar el archivo .env.local real.
GUARDIA_PIN=
SESSION_SECRET=
